&CONTROL
 calculation = 'relax',
 prefix = 'Cu3Fe9_N2_Fe_relax',
 outdir = './tmp_relax',
 pseudo_dir = './pseudo',
 restart_mode = 'from_scratch',
 tprnfor = .true.,
/
&SYSTEM
 ibrav = 0,
 nat = 14,
 ntyp = 3,
 ecutwfc = 70,
 ecutrho = 560,
 nspin = 2,
 starting_magnetization(1) = 0.35,
 starting_magnetization(2) = 0.02,
 starting_magnetization(3) = 0.0,
 occupations = 'smearing',
 smearing = 'mv',
 degauss = 0.02,
/
&ELECTRONS
 conv_thr = 1.0d-6,
 electron_maxstep = 150,
 mixing_beta = 0.2,
/
&IONS
 ion_dynamics = 'bfgs',
/

